{
  "mcpServers": {
    "fiverr": {
      "command": "uvx",
      "args": [
        "--from",
        "fiverr-mcp-server==0.1.1",
        "--with",
        "mcp[cli]>=1.0.0,<2",
        "fiverr-mcp-server"
      ],
      "env": {
        "TRANSPORT": "stdio",
        "RATE_LIMIT_DELAY": "2"
      }
    }
  }
}
