{
  "mcpServers": {
    "fiverr": {
      "command": "uvx",
      "args": [
        "--from",
        "fiverr-mcp-server==0.1.1",
        "--with",
        "mcp[cli]>=1.0.0,<2",
        "fiverr-mcp-server"
      ],
      "env": {
        "TRANSPORT": "stdio",
        "RATE_LIMIT_DELAY": "2"
      }
    },
    "fiverr-agent": {
      "command": "fiverr-agent-mcp",
      "args": [],
      "env": {
        "FIVERR_HEADLESS": "true",
        "FIVERR_DRY_RUN": "true",
        "FIVERR_LOG_LEVEL": "INFO"
      }
    }
  }
}
