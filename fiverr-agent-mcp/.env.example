# =============================================================================
# Fiverr Agent MCP — environment configuration
# Copy to `.env` and fill in. NEVER commit your real `.env`.
# In production, prefer supplying secrets via the process environment / a secrets
# manager rather than a file on disk.
# =============================================================================

# --- Credentials (required for credential login; env only, never logged) -----
FIVERR_EMAIL=you@example.com
FIVERR_PASSWORD=your-fiverr-password

# --- Session encryption ------------------------------------------------------
# Fernet key that encrypts the saved browser session at rest.
# Generate one with:  python -m fiverr_agent_mcp.smoke --gen-key
# If unset, the session is stored UNENCRYPTED and a warning is logged.
FIVERR_SESSION_KEY=

# Where session/state files are stored (default: ~/.fiverr-agent-mcp)
# FIVERR_STATE_DIR=~/.fiverr-agent-mcp
# FIVERR_SESSION_FILE=session.enc

# --- Browser behavior --------------------------------------------------------
# Run Chromium headless (true) or with a visible window (false — useful for the
# first login / solving a challenge manually).
FIVERR_HEADLESS=true
# Slow down each action by N ms (0 = full speed). Handy for debugging.
FIVERR_SLOW_MO_MS=0
# Per-action / navigation timeouts (ms).
FIVERR_TIMEOUT_MS=30000
FIVERR_NAV_TIMEOUT_MS=45000
# Retries per action and exponential backoff base (seconds).
FIVERR_MAX_RETRIES=3
FIVERR_RETRY_BACKOFF_S=1.0
# Optional custom user agent / locale.
# FIVERR_USER_AGENT=
FIVERR_LOCALE=en-US

# --- Safety rails ------------------------------------------------------------
# When true, every mutating tool (send/deliver/offer/...) refuses to act and
# returns a preview instead. Great for testing. Set to false to go live.
FIVERR_DRY_RUN=true

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
FIVERR_LOG_LEVEL=INFO
# Emit structured JSON log lines instead of text.
FIVERR_LOG_JSON=false

# --- Transport ---------------------------------------------------------------
# stdio (default) | streamable-http | sse
FIVERR_TRANSPORT=stdio

# --- Endpoints (rarely changed) ----------------------------------------------
# FIVERR_BASE_URL=https://www.fiverr.com
