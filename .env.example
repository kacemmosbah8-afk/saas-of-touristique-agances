# Copy to .env.local for local development. Never commit real secrets.

# --- Database (Neon Postgres recommended; any Postgres 15+ works) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/travelos?schema=public"
# Direct (non-pooled) connection string, used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@localhost:5432/travelos?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional in dev — leave blank to disable the provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- UploadThing ---
UPLOADTHING_TOKEN=""

# --- External integrations (M3) ---
# Duffel flight API (test or live token)
DUFFEL_TOKEN=
# Hotelbeds Hotel API
HOTELBEDS_HOTEL_API_KEY=
HOTELBEDS_HOTEL_SECRET=
# "test" or "live"
HOTELBEDS_ENVIRONMENT=test
# Amadeus (optional — provider shows "Awaiting credentials" until set)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
