# Copy to .env.local for local development. Never commit real secrets.

# --- Database (Neon Postgres recommended; any Postgres 15+ works) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/travelos?schema=public"
# Direct (non-pooled) connection string, used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@localhost:5432/travelos?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional in dev — leave blank to disable the provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- UploadThing ---
UPLOADTHING_TOKEN=""
