// TravelOS — core data model (Milestone M0)
//
// Multi-tenancy strategy: shared schema, shared tables, every tenant-scoped
// model carries a `tenantId` column. Enforcement happens at two independent
// layers:
//   1. Application layer — `src/shared/lib/db.ts` exposes a tenant-scoped
//      Prisma Client Extension that injects `tenantId` into every query for
//      tenant-scoped models.
//   2. Database layer — Postgres Row-Level Security policies (see
//      prisma/sql/001_row_level_security.sql) as defense-in-depth.
//
// No business-domain models (bookings, itineraries, CRM, finance, ...) are
// defined yet — those belong to their own milestones. M0 only ships the
// identity, tenancy, and audit backbone every future feature builds on.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A travel agency. The root of every tenant-scoped relation in the system.
model Tenant {
  id   String @id @default(cuid())
  /// URL-safe identifier used for path-based tenant resolution: /app/[slug]/...
  slug String @unique
  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships         Membership[]
  invitations         Invitation[]
  auditLogs           AuditLog[]
  packages            Package[]
  packageImages       PackageImage[]
  itineraryDays       ItineraryDay[]
  itineraryActivities ItineraryActivity[]

  // M2 — Suppliers & Inventory
  hotels             Hotel[]
  hotelImages        HotelImage[]
  roomTypes          RoomType[]
  transportProviders TransportProvider[]
  guides             Guide[]
  suppliers          Supplier[]
  supplierDocuments  SupplierDocument[]
  activities         Activity[]
  activityImages     ActivityImage[]
  destinations       Destination[]
  destinationImages  DestinationImage[]
  flights            Flight[]
  flightImages       FlightImage[]
  packageHotels      PackageHotel[]
  packageActivities  PackageActivity[]
  packageGuides      PackageGuide[]
  packageTransport   PackageTransport[]
  packageSuppliers   PackageSupplier[]

  // M3 — CRM, Leads, Documents, Providers, Settings
  customers             Customer[]
  tags                  Tag[]
  leads                 Lead[]
  bookingRequests       BookingRequest[]
  documents             Document[]
  communicationMessages CommunicationMessage[]
  providers             Provider[]
  travelCategories      TravelCategory[]
  customFields          CustomField[]
  settings              TenantSettings?

  // M4 — Booking Engine
  bookings          Booking[]
  bookingItems      BookingItem[]
  bookingActivities BookingActivity[]

  // M4 Sprint 2 — Quotes
  quotes          Quote[]
  quoteItems      QuoteItem[]
  quoteActivities QuoteActivity[]

  // M4 Sprint 4 — Agency Operations
  bookingTravellers     BookingTraveller[]
  supplierConfirmations SupplierConfirmation[]
  vouchers              Voucher[]

  // Platform Automation Capability
  jobs      Job[]
  jobEvents JobEvent[]

  // Customer Portal Capability
  portalMagicLinks PortalMagicLink[]
  portalSessions   PortalSession[]

  @@map("tenants")
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Links a User to a Tenant with a role. A user may belong to more than one
/// agency (e.g. a freelance consultant working with multiple shops).
model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  role   MembershipRole
  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("memberships")
}

/// A pending invite for someone (existing user or not) to join a Tenant.
model Invitation {
  id       String         @id @default(cuid())
  tenantId String
  email    String
  role     MembershipRole

  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Packages
// ---------------------------------------------------------------------------

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PackageDifficulty {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
}

/// A travel package offered by a tenant.
model Package {
  id       String @id @default(cuid())
  tenantId String
  name     String
  slug     String

  // Core details
  shortDescription String?
  description      String?            @db.Text
  destination      String?
  country          String?
  duration         Int?
  durationNights   Int?
  category         String?
  difficulty       PackageDifficulty?
  featured         Boolean            @default(false)

  // French translations — Arabic (the bare fields above) is this tenant's
  // primary language; French is the one secondary language the public site
  // can switch to (see PROJECT.md, bilingual content sprint). Every field a
  // traveler actually reads has an `Fr` sibling; codes, prices, and media
  // keys don't.
  nameFr             String?
  shortDescriptionFr String?
  descriptionFr      String? @db.Text
  destinationFr      String?
  countryFr          String?
  categoryFr         String?

  // Pricing — an agent-set indicative "from" price shown on the public
  // storefront, not a live-computed figure from the Quote/pricing engine.
  // Final pricing is always confirmed by a human via the Request-to-Book
  // flow; this field exists purely so a visitor can self-qualify on budget
  // before reaching out, matching the sellingPrice/currency convention
  // already used by Activity.
  internalCost Decimal? @db.Decimal(12, 2)
  sellingPrice Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  // Media
  coverImageKey String?
  coverImageUrl String?

  // Builder sections (stored as PostgreSQL TEXT arrays)
  highlights       String[]
  includedServices String[]
  excludedServices String[]
  importantNotes   String[]
  whatToBring      String[]

  // Builder sections — French
  highlightsFr       String[]
  includedServicesFr String[]
  excludedServicesFr String[]
  importantNotesFr   String[]
  whatToBringFr      String[]

  // Builder text sections
  cancellationPolicy String? @db.Text
  meetingPoint       String?

  // Builder text sections — French
  cancellationPolicyFr String? @db.Text
  meetingPointFr        String?

  // SEO
  seoTitle       String?
  seoDescription String?

  // SEO — French
  seoTitleFr       String?
  seoDescriptionFr String?

  status    PackageStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images        PackageImage[]
  itineraryDays ItineraryDay[]

  // M2 — inventory relationships
  packageHotels     PackageHotel[]
  packageActivities PackageActivity[]
  packageGuides     PackageGuide[]
  packageTransport  PackageTransport[]
  packageSuppliers  PackageSupplier[]

  // M4 — Booking Engine
  bookings Booking[]

  // M4 Sprint 2 — Pricing & Quotes
  quotes Quote[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("packages")
}

/// Individual gallery image belonging to a package.
model PackageImage {
  id        String  @id @default(cuid())
  tenantId  String
  packageId String
  fileKey   String
  url       String
  alt       String?
  altFr     String?
  position  Int     @default(0)

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([packageId, position])
  @@map("package_images")
}

// ---------------------------------------------------------------------------
// Itinerary
// ---------------------------------------------------------------------------

/// A single day in a package itinerary. Days are ordered by `dayNumber`.
model ItineraryDay {
  id        String @id @default(cuid())
  tenantId  String
  packageId String

  dayNumber   Int
  title       String
  description String? @db.Text
  notes       String? @db.Text

  // Meals (free-text notes per meal slot)
  mealBreakfast String?
  mealLunch     String?
  mealDinner    String?

  // Logistics
  transferNotes      String? @db.Text
  accommodationNotes String? @db.Text

  // French translations
  titleFr              String?
  descriptionFr        String? @db.Text
  notesFr              String? @db.Text
  mealBreakfastFr      String?
  mealLunchFr          String?
  mealDinnerFr         String?
  transferNotesFr      String? @db.Text
  accommodationNotesFr String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package    Package             @relation(fields: [packageId], references: [id], onDelete: Cascade)
  activities ItineraryActivity[]

  @@unique([packageId, dayNumber])
  @@index([tenantId])
  @@index([packageId, dayNumber])
  @@map("itinerary_days")
}

/// An activity within a single itinerary day. Activities are ordered by `position`.
model ItineraryActivity {
  id       String @id @default(cuid())
  tenantId String
  dayId    String

  position    Int     @default(0)
  title       String
  description String? @db.Text
  duration    Int? // minutes

  // French translations
  titleFr       String?
  descriptionFr String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day    ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dayId, position])
  @@map("itinerary_activities")
}

// ---------------------------------------------------------------------------
// Suppliers & Inventory (Milestone M2)
//
// Shared resource lifecycle: `ResourceStatus` models the active/inactive state
// of a supplier resource, while `deletedAt` is a soft-delete tombstone. Lists
// always filter `deletedAt: null`; "Archive/Restore" flips status, "Delete"
// sets the tombstone. Money is stored as Decimal(12,2) and converted to plain
// numbers in query mappers so it can cross the Server→Client boundary.
// ---------------------------------------------------------------------------

enum ResourceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Hotels
// ---------------------------------------------------------------------------

enum HotelCategory {
  BUDGET
  STANDARD
  BOUTIQUE
  LUXURY
  RESORT
  RIAD
  GUESTHOUSE
  HOSTEL
}

enum RoomTypeKind {
  STANDARD
  DELUXE
  SUITE
  FAMILY
  CUSTOM
}

/// A hotel a tenant works with. Not booking inventory yet — a catalogue entry
/// that packages can later reference.
model Hotel {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  nameFr   String?
  /// Public storefront URL segment — /[tenantSlug]/hotels/[slug]. Same
  /// per-tenant-unique convention as Package.slug.
  slug     String
  /// Highlighted on the storefront homepage, same convention as
  /// Package.featured.
  featured Boolean @default(false)

  category HotelCategory @default(STANDARD)
  stars    Int?

  country   String?
  city      String?
  address   String?
  latitude  Float?
  longitude Float?

  description String?  @db.Text
  amenities   String[]

  // French translations
  countryFr     String?
  cityFr        String?
  addressFr     String?
  descriptionFr String?  @db.Text
  amenitiesFr   String[]

  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?

  internalNotes String? @db.Text

  coverImageKey String?
  coverImageUrl String?

  /// Set when imported from an external provider via the sync system.
  source       ProviderType?
  externalCode String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images        HotelImage[]
  roomTypes     RoomType[]
  packageHotels PackageHotel[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, country, city])
  @@index([tenantId, source, externalCode])
  @@map("hotels")
}

model HotelImage {
  id       String  @id @default(cuid())
  tenantId String
  hotelId  String
  /// Nullable: an UploadThing-hosted image has a real fileKey; an image
  /// synced from a content provider (source/externalCode on the parent
  /// Hotel) is a direct external URL with no local file, so this is null.
  fileKey  String?
  url      String
  alt      String?
  altFr    String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotel  Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hotelId, position])
  @@map("hotel_images")
}

/// A room category within a Hotel. Room images are stored as a flat array of
/// URLs (simpler than a join table for what is effectively a small gallery).
model RoomType {
  id       String @id @default(cuid())
  tenantId String
  hotelId  String

  kind RoomTypeKind @default(STANDARD)
  name String

  // French translations
  nameFr  String?
  notesFr String? @db.Text

  capacity  Int  @default(2)
  beds      Int?
  occupancy Int?

  basePrice    Decimal? @db.Decimal(12, 2)
  internalCost Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  images String[]
  notes  String?  @db.Text

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotel  Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hotelId, position])
  @@map("room_types")
}

// ---------------------------------------------------------------------------
// Transportation
// ---------------------------------------------------------------------------

enum TransportType {
  AIRPORT_TRANSFER
  BUS
  PRIVATE
  CAR_RENTAL
  BOAT
  CUSTOM
}

model TransportProvider {
  id       String @id @default(cuid())
  tenantId String
  name     String

  type TransportType @default(PRIVATE)

  country String?
  city    String?

  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?

  fleetNotes    String? @db.Text
  pricingNotes  String? @db.Text
  internalNotes String? @db.Text

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageTransport PackageTransport[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("transport_providers")
}

// ---------------------------------------------------------------------------
// Tour Guides
// ---------------------------------------------------------------------------

model Guide {
  id       String @id @default(cuid())
  tenantId String
  name     String

  languages       String[]
  certifications  String[]
  experienceYears Int?

  dailyRate Decimal? @db.Decimal(12, 2)
  currency  String   @default("USD")

  country String?
  city    String?

  contactEmail String?
  contactPhone String?

  availabilityNotes String? @db.Text
  internalNotes     String? @db.Text

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageGuides PackageGuide[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("guides")
}

// ---------------------------------------------------------------------------
// Suppliers
// ---------------------------------------------------------------------------

enum SupplierType {
  HOTEL
  FLIGHT
  TRANSPORT
  ACTIVITY
  RESTAURANT
  GUIDE
  VISA
  INSURANCE
  OTHER
}

model Supplier {
  id       String @id @default(cuid())
  tenantId String
  name     String

  type SupplierType @default(OTHER)

  contactName String?
  email       String?
  phone       String?
  website     String?
  address     String?
  country     String?
  city        String?

  /// Internal rating 1–5. Null when unrated.
  internalRating Int?

  notes String? @db.Text

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents        SupplierDocument[]
  contacts         SupplierContact[]
  packageSuppliers PackageSupplier[]
  activities       Activity[]
  confirmations    SupplierConfirmation[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("suppliers")
}

/// Contracts and other files attached to a supplier. `kind` distinguishes
/// contracts from generic documents without a separate table.
model SupplierDocument {
  id         String @id @default(cuid())
  tenantId   String
  supplierId String

  name    String
  kind    String @default("document")
  fileKey String
  url     String

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierId])
  @@map("supplier_documents")
}

// ---------------------------------------------------------------------------
// Activities
// ---------------------------------------------------------------------------

model Activity {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  nameFr   String?
  /// Public storefront URL segment — /[tenantSlug]/activities/[slug]. Same
  /// per-tenant-unique convention as Package.slug.
  slug     String
  /// Highlighted on the storefront homepage, same convention as
  /// Package.featured.
  featured Boolean @default(false)

  category        String?
  durationMinutes Int?
  meetingPoint    String?

  description   String?  @db.Text
  includedItems String[]
  excludedItems String[]

  country String?
  city    String?

  // French translations
  categoryFr      String?
  meetingPointFr  String?
  descriptionFr   String?  @db.Text
  includedItemsFr String[]
  excludedItemsFr String[]
  countryFr       String?
  cityFr          String?

  supplierId String?

  internalCost Decimal? @db.Decimal(12, 2)
  sellingPrice Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  coverImageKey String?
  coverImageUrl String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images            ActivityImage[]
  packageActivities PackageActivity[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([supplierId])
  @@map("activities")
}

model ActivityImage {
  id         String  @id @default(cuid())
  tenantId   String
  activityId String
  fileKey    String
  url        String
  alt        String?
  altFr      String?
  position   Int     @default(0)

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([activityId, position])
  @@map("activity_images")
}

// ---------------------------------------------------------------------------
// Destinations
// ---------------------------------------------------------------------------

model Destination {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  nameFr   String?
  /// Public storefront URL segment — /[tenantSlug]/destinations/[slug].
  /// Same per-tenant-unique convention as Package.slug.
  slug     String
  /// Highlighted on the storefront homepage, same convention as
  /// Package.featured.
  featured Boolean @default(false)

  country String
  region  String?
  city    String?

  description String? @db.Text

  heroImageKey String?
  heroImageUrl String?

  popularAttractions String[]

  seoTitle       String?
  seoDescription String?

  // French translations
  countryFr            String?
  regionFr             String?
  cityFr               String?
  descriptionFr        String? @db.Text
  popularAttractionsFr String[]
  seoTitleFr           String?
  seoDescriptionFr     String?

  /// Set when imported from an external content provider via sync —
  /// mirrors Hotel.source/externalCode exactly. Null for agency-authored
  /// destinations (the pre-existing, unaffected write path).
  source       ProviderType?
  externalCode String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gallery DestinationImage[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, country])
  @@index([tenantId, source, externalCode])
  @@map("destinations")
}

model DestinationImage {
  id            String  @id @default(cuid())
  tenantId      String
  destinationId String
  /// Nullable for the same reason as HotelImage.fileKey — a synced image
  /// has no local UploadThing file.
  fileKey       String?
  url           String
  alt           String?
  altFr         String?
  position      Int     @default(0)

  createdAt DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([destinationId, position])
  @@map("destination_images")
}

// ---------------------------------------------------------------------------
// Flights
// ---------------------------------------------------------------------------

/// A sellable flight route/offer on the public storefront — not a live
/// schedule lookup, an agency-authored listing (route, typical timing,
/// airline, price) the same way Package is an agency-authored trip. Uses
/// `PackageStatus` (not `ResourceStatus`) since publish/unpublish is an
/// explicit, first-class workflow here exactly like Package's.
model Flight {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  slug     String
  featured Boolean @default(false)

  shortDescription String?
  description      String? @db.Text

  // Airline name/flight number are proper nouns/codes — not translated.
  airline        String?
  airlineLogoUrl String?
  flightNumber   String?

  departureCity    String?
  departureAirport String?
  departureCountry String?
  arrivalCity      String?
  arrivalAirport   String?
  arrivalCountry   String?
  /// Typical time-of-day for this route (e.g. "08:00"), not a specific
  /// calendar date — a traveler picks their actual date when they submit a
  /// booking request.
  departureTime    String?
  arrivalTime      String?

  durationMinutes Int?
  /// 0 = direct/nonstop.
  stops           Int     @default(0)
  cabinClass      String?

  basePrice Decimal? @db.Decimal(12, 2)
  currency  String   @default("USD")

  coverImageKey String?
  coverImageUrl String?

  seoTitle       String?
  seoDescription String?

  // French translations
  nameFr             String?
  shortDescriptionFr String?
  descriptionFr      String? @db.Text
  departureCityFr    String?
  departureAirportFr String?
  departureCountryFr String?
  arrivalCityFr      String?
  arrivalAirportFr   String?
  arrivalCountryFr   String?
  cabinClassFr       String?
  seoTitleFr         String?
  seoDescriptionFr   String?

  status    PackageStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images FlightImage[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, departureCity, arrivalCity])
  @@map("flights")
}

model FlightImage {
  id       String  @id @default(cuid())
  tenantId String
  flightId String
  fileKey  String?
  url      String
  alt      String?
  altFr    String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([flightId, position])
  @@map("flight_images")
}

// ---------------------------------------------------------------------------
// Package inventory relationships (Modules 7 & 8)
//
// Join tables linking a Package to the resources it uses. `position` supports
// drag-and-drop ordering within each resource group. No booking/pricing logic
// yet — only the relationships.
// ---------------------------------------------------------------------------

model PackageHotel {
  id        String @id @default(cuid())
  tenantId  String
  packageId String
  hotelId   String

  position Int     @default(0)
  notes    String?

  createdAt DateTime @default(now())

