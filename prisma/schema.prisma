// ---------------------------------------------------------------------------
// Payment Configuration — which payment method a supplier-execution provider
// requests when creating a real order (Duffel's `payments[].type`, etc.).
// Deliberately separate from ProviderCredential: credentials answer "which
// account calls the API," this answers "how should that account's calls pay."
// Provider-agnostic by design — a future Hotelbeds/Amadeus payment concept is
// a second row keyed by its own ProviderType, never a schema change. Stores
// no card/account data — only a method-type selection and a display label;
// real card data, when CARD is ever fully implemented, lives only inside
// Duffel's own PCI-compliant components/session ids, never in this database.
// ---------------------------------------------------------------------------

/// What a supplier-execution provider is asked to charge when creating a
/// real order. BALANCE debits the connected account's own pre-funded
/// balance (Duffel: funded via bank transfer in Duffel's own dashboard —
/// this app has no API visibility into or control over that funding
/// source). CARD is a placeholder for Duffel's one-time-use card + 3DS
/// session flow (see PROJECT.md) — declared here so the architecture is
/// ready, not implemented yet; selecting it is rejected until it is.
/// ARC_BSP_CASH mirrors Duffel's own third payment type for accredited
/// agencies, same "declared, not yet implemented" status as CARD.
enum PaymentMethodType {
  BALANCE
  CARD
  ARC_BSP_CASH
}

model PaymentConfiguration {
  id       String @id @default(cuid())
  tenantId String

  /// Which supplier-execution provider this payment configuration applies
  /// to (today: DUFFEL only — the one provider whose `execute()` can move
  /// real money via a payment method choice).
  provider   ProviderType
  methodType PaymentMethodType @default(BALANCE)
  /// Human-readable, shown as-is in the settings UI — e.g. "Duffel Account
  /// Balance". Never a card number, name, or other sensitive value.
  label      String
  isActive   Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("payment_configurations")
}

// ---------------------------------------------------------------------------
// Imported reference data (M3 — External Integrations)
//
// Provider-independent copies of external catalogue data (countries, cities,
// airports, airlines, amenities), imported per tenant via the sync system.
// `source` records which provider a row came from; `code` is the provider's
// stable identifier, unique per tenant.
