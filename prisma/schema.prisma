// ---------------------------------------------------------------------------
// Identity (Auth.js)
// ---------------------------------------------------------------------------

/// A person. Deliberately tenant-agnostic — tenancy lives on Membership.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  /// Set only for the Credentials provider. Null for OAuth-only users.
  passwordHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("users")
}

/// Required by @auth/prisma-adapter for OAuth account linking.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Required by @auth/prisma-adapter's type contract. Unused for reads/writes
/// of the active session under the JWT session strategy (see auth strategy in
/// PROJECT.md) but kept so the adapter type-checks and so we can switch to
/// database sessions later without a schema migration.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of who changed what. Required from day one because
/// booking/finance data (added in later milestones) needs a defensible trail.
model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  userId   String?

  action   String
  entity   String
  entityId String?
  metadata Json?

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// M4 — Booking Engine (Sprint 1: core reservations, no payments/invoicing yet)
// ---------------------------------------------------------------------------

/// Lifecycle of a booking. Deliberately excludes payment states — invoicing
/// and payments are a later sprint. DRAFT is the working state; CONFIRMED
/// locks the reservation; IN_PROGRESS/COMPLETED track fulfilment; CANCELLED
/// is terminal. Allowed transitions are enforced in the domain layer
/// (features/bookings/lib/status.ts), not by the database.
enum BookingStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// The category of a booking line item. Mirrors the inventory modules so a
/// line can optionally point back at a Hotel/Activity/Guide/Transport record
/// via `referenceId`, plus FLIGHT (external providers) and free-form OTHER.
enum BookingItemType {
  HOTEL
  TRANSPORT
  ACTIVITY
  GUIDE
  FLIGHT
  PACKAGE
  OTHER
}

/// Timeline event types for a booking, mirroring the CRM/Leads activity feeds.
enum BookingActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  CANCELLED
  NOTE
}

/// A reservation for a customer. Monetary columns (`subtotal`/`total`) are
/// derived from `items` and recomputed whenever items or discount/tax change
/// — they are stored (not computed on read) so list/report queries stay cheap
/// and a booking's recorded price is stable even if inventory prices move.
model Booking {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "BK-2026-0001").
  reference String

  customerId String
  packageId  String?
  /// Assigned agent (userId). Plain string — see header note on ownerId.
  ownerId    String?

  status BookingStatus @default(DRAFT)

  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(1)
  children        Int       @default(0)

  currency String  @default("USD")
  /// Sum of item amounts. Recomputed by the domain layer on every item change.
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  /// subtotal - discount + tax. Recomputed alongside subtotal.
  total    Decimal @default(0) @db.Decimal(12, 2)

  notes         String? @db.Text
  internalNotes String? @db.Text

  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: a customer with bookings cannot be hard-deleted out from under
  // them (customers are soft-deleted anyway); keeps the reservation's owner intact.
  customer             Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package              Package?               @relation(fields: [packageId], references: [id], onDelete: SetNull)
  items                BookingItem[]
  activities           BookingActivity[]
  // M4 Sprint 2 — the quote this booking was converted from, if any.
  quote                Quote?
  // M4 Sprint 3 — invoices generated from this booking (deposit + balance
  // invoices are separate records, so this is a list, not a unique link).
  invoices             Invoice[]
  // M4 Sprint 4 — Agency Operations
  travellers           BookingTraveller[]
  cancellation         BookingCancellation?
  confirmations        SupplierConfirmation[]
  vouchers             Voucher[]
  /// The cancellation policy governing this booking, if one is assigned.
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy?    @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  // Supplier Order Execution Capability
  supplierOrders       SupplierOrder[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([customerId])
  @@index([packageId])
  @@map("bookings")
}

/// A single priced line on a booking. `referenceId` is an optional, FK-free
/// pointer to the inventory record the line was drawn from — intentionally not
/// a foreign key so inventory can be edited/removed without rewriting historical
/// bookings (the line keeps its captured `description`/`unitPrice`).
model BookingItem {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String

  type        BookingItemType
  description String
  referenceId String?

  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice, captured at write time.
  amount    Decimal @default(0) @db.Decimal(12, 2)

  notes     String?
  sortOrder Int     @default(0)

  /// Rate conditions/notices the supplier attached to this line at booking
  /// time (Hotelbeds rateComments, captured verbatim). Null when the
  /// supplier reported none, or for non-supplier (manual) line items.
  supplierRateComments String? @db.Text

  /// The raw supplier cost this line's `unitPrice` was priced from (the
  /// Universal Pricing Engine's input), captured at booking-prep time —
  /// same snapshot-at-write precedent as `supplierRateComments`. Null for
  /// manually-entered lines with no live supplier price behind them.
  /// `unitPrice` is what the customer is charged; this is what the
  /// supplier is owed — the two must never be conflated (see PROJECT.md,
  /// "Universal Pricing Engine").
  supplierCost Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // M4 Sprint 4 — Agency Operations
  confirmation SupplierConfirmation?
  vouchers     Voucher[]

  // Supplier Order Execution Capability
  supplierOrder SupplierOrder?

  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_items")
}

/// Append-only timeline entry for a booking (who did what, when).
model BookingActivity {
  id        String  @id @default(cuid())
  tenantId  String
  bookingId String
  /// Actor. Nullable so system-generated events don't require a user.
  userId    String?

  type        BookingActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_activities")
}

// ---------------------------------------------------------------------------
// M4 Sprint 2 — Pricing & Quotes
//
// A Quote is the pre-sale proposal that precedes a Booking: a priced offer
// sent to a customer that, once ACCEPTED, converts one-to-one into a Booking.
// It reuses the exact money model as bookings (stored integer-cents-derived
// Decimal totals, recomputed from lines) and the same line taxonomy
// (BookingItemType) so a quote line maps directly onto a booking line at
// conversion. Transitions are enforced in the domain layer
// (features/quotes/lib/quote-status.ts), not by the database.
// ---------------------------------------------------------------------------

/// Lifecycle of a quote. DRAFT is the working state; SENT is delivered to the
/// customer; ACCEPTED/DECLINED capture the customer's decision; EXPIRED is set
/// once `validUntil` passes without acceptance; CONVERTED is terminal and means
/// the quote was turned into a Booking. Allowed transitions live in the domain
/// layer.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

/// Timeline event types for a quote, mirroring the booking activity feed.
enum QuoteActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  ASSIGNED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  NOTE
}

/// A priced proposal for a customer. Monetary columns are stored (not computed
/// on read), recomputed from `items` + discount/tax on every change — identical
/// discipline to Booking. `convertedBookingId` links a CONVERTED quote to the
/// Booking it produced (unique: a quote converts at most once).
model Quote {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "QT-2026-0001").
  reference String

  customerId String
  packageId  String?
  /// Assigned agent (userId). Plain string — mirrors Booking.ownerId.
  ownerId    String?

  status QuoteStatus @default(DRAFT)

  /// The offer's expiry. Past this date the quote may be moved to EXPIRED.
  validUntil      DateTime?
  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(1)
  children        Int       @default(0)

  currency String  @default("USD")
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  /// Customer-facing proposal notes and terms (shown on the quote).
  notes         String? @db.Text
  terms         String? @db.Text
  internalNotes String? @db.Text

  sentAt      DateTime?
  acceptedAt  DateTime?
  declinedAt  DateTime?
  convertedAt DateTime?

  /// Set when the quote is converted into a booking (terminal CONVERTED state).
  convertedBookingId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package          Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  // The booking produced by converting this quote. SetNull: deleting that
  // booking must not delete the historical quote record.
  convertedBooking Booking?        @relation(fields: [convertedBookingId], references: [id], onDelete: SetNull)
  items            QuoteItem[]
  activities       QuoteActivity[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([customerId])
  @@index([packageId])
  @@map("quotes")
}

/// A single priced line on a quote. Same shape as BookingItem so conversion is
/// a direct field copy. `referenceId` is an FK-free pointer to the inventory
/// record the line/price was drawn from (see the pricing catalog query).
model QuoteItem {
  id       String @id @default(cuid())
  tenantId String
  quoteId  String

  type        BookingItemType
  description String
  referenceId String?

  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice, captured at write time.
  amount    Decimal @default(0) @db.Decimal(12, 2)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("quote_items")
}

/// Append-only timeline entry for a quote (who did what, when).
model QuoteActivity {
  id       String  @id @default(cuid())
  tenantId String
  quoteId  String
  /// Actor. Nullable so system-generated events don't require a user.
  userId   String?

  type        QuoteActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("quote_activities")
}

// ---------------------------------------------------------------------------
// M4 Sprint 3 — Invoicing & Payments
//
// The post-sale half of the revenue funnel: a Booking generates an Invoice,
// and Payments are recorded against the invoice until its balance is settled.
// This sprint is a payment *ledger*, not a payment gateway — money is received
// out-of-band (cash, bank transfer, card terminal, cheque) and recorded here.
// PaymentTransaction is the append-only CHARGE/REFUND ledger a future gateway
// adapter would write into, so adding online payments later is additive.
//
// Money discipline is identical to Booking/Quote: stored Decimal columns
// derived via integer-cents arithmetic (shared/lib/money.ts), recomputed by
// the domain layer after every mutation. Balance columns (amountPaid /
// amountRefunded / amountCredited) are stored the same way and recomputed by
// features/invoices/lib/recompute-balance.ts after every payment, refund, or
// credit-note change. Lifecycle transitions are enforced in the domain layer
// (features/invoices/lib/invoice-status.ts), not by the database.
// ---------------------------------------------------------------------------

/// Lifecycle of an invoice. DRAFT is editable; ISSUED locks the lines and
/// starts collection; PARTIALLY_PAID/PAID are *system* states driven by
/// recorded payments (never set manually); VOID cancels an invoice that has
/// no net payments. Overdue is deliberately NOT a stored status — it is
/// derived from `dueDate` + balance at read time so it never goes stale.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// Timeline event types for an invoice, mirroring the booking/quote feeds.
enum InvoiceActivityType {
  CREATED
  UPDATED
  ISSUED
  STATUS_CHANGED
  PAYMENT_RECORDED
  PAYMENT_REFUNDED
  CREDIT_NOTE_ISSUED
  CREDIT_NOTE_VOIDED
  INSTALLMENT_PLAN_CREATED
  INSTALLMENT_PLAN_REMOVED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  VOIDED
  NOTE
  /// Sprint X, Milestone 1 — an "invoice issued" email was sent (or resent)
  /// to the customer. Best-effort: issuing an invoice never fails because
  /// the email couldn't be sent, so this entry only appears when a send
  /// actually succeeded.
  EMAIL_SENT
}

/// How a payment was received. This is a recording taxonomy, not a gateway
/// integration — ONLINE covers any provider-processed payment recorded here.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  ONLINE
  OTHER
}

/// Lifecycle of a recorded payment. COMPLETED payments count toward the
/// invoice balance; PENDING (e.g. a bank transfer awaiting arrival) and
/// FAILED do not. REFUNDED/PARTIALLY_REFUNDED are set by the refund action
/// from the payment's refunded amount.
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// What the payment is for, within the invoice's collection plan. DEPOSIT is
/// the up-front portion; INSTALLMENT pays a scheduled installment; BALANCE is
/// any other payment toward the outstanding amount.
enum PaymentKind {
  DEPOSIT
  INSTALLMENT
  BALANCE
}

/// Append-only ledger entry types under a payment. Recording a payment writes
/// a CHARGE; each refund writes a REFUND. Rows are never updated or deleted.
enum PaymentTransactionType {
  CHARGE
  REFUND
}

/// Timeline event types for a payment.
enum PaymentActivityType {
  CREATED
  COMPLETED
  FAILED
  REFUNDED
  UPDATED
  NOTE
}

/// Lifecycle of a credit note. ISSUED reduces the invoice's amount owed;
/// VOID reverses that (the note is kept for the audit trail, never deleted).
enum CreditNoteStatus {
  ISSUED
  VOID
}

/// Scheduled-installment state. PAID is set when linked completed payments
/// cover the installment amount. Overdue is derived from `dueDate` at read
/// time, same as the invoice's overdue flag.
enum InstallmentStatus {
  PENDING
  PAID
}

/// A bill for a customer, usually generated from a Booking (bookingId), but a
/// manual invoice with no booking is allowed. Monetary columns follow the
/// Booking/Quote discipline (stored, recomputed from lines); the balance
/// columns are recomputed from payments/credit notes on every financial
/// mutation. Balance due = total − amountCredited − (amountPaid − amountRefunded),
/// clamped at zero, all derived in integer cents.
model Invoice {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "INV-2026-0001").
  reference String

  bookingId  String?
  customerId String

  status InvoiceStatus @default(DRAFT)

  issuedAt DateTime?
  /// Payment deadline. Past this date with a balance due, the invoice is
  /// overdue (derived at read time, not a stored status).
  dueDate  DateTime?
  paidAt   DateTime?

  currency String  @default("USD")
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  /// Sum of COMPLETED payment charges. Recomputed after every payment change.
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  /// Sum of refund transactions. Recomputed alongside amountPaid.
  amountRefunded Decimal @default(0) @db.Decimal(12, 2)
  /// Sum of ISSUED credit notes. Recomputed on credit-note changes.
  amountCredited Decimal @default(0) @db.Decimal(12, 2)

  notes         String? @db.Text
  terms         String? @db.Text
  internalNotes String? @db.Text

  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // SetNull: deleting a booking must not destroy its financial records.
  booking         Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           InvoiceItem[]
  activities      InvoiceActivity[]
  payments        Payment[]
  creditNotes     CreditNote[]
  installmentPlan InstallmentPlan?

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([bookingId])
  @@index([customerId])
  @@map("invoices")
}

/// A single priced line on an invoice. Same shape as BookingItem/QuoteItem
/// (reusing BookingItemType) so booking→invoice generation is a direct copy.
model InvoiceItem {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  type        BookingItemType
  description String
  referenceId String?

  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice, captured at write time.
  amount    Decimal @default(0) @db.Decimal(12, 2)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_items")
}

/// Append-only timeline entry for an invoice (who did what, when).
model InvoiceActivity {
  id        String  @id @default(cuid())
  tenantId  String
  invoiceId String
  /// Actor. Nullable so system-generated events don't require a user.
  userId    String?

  type        InvoiceActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_activities")
}

/// A payment received against an invoice. `amount` is the charge; refunds
/// accumulate in `refundedAmount` (never exceeding `amount`) via REFUND
/// transactions. Currency always equals the invoice currency (enforced in
/// the action layer — no cross-currency settlement in this sprint).
model Payment {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "PAY-2026-0001").
  reference String

  invoiceId     String
  /// The scheduled installment this payment settles, if any.
  installmentId String?

  method PaymentMethod
  kind   PaymentKind   @default(BALANCE)
  status PaymentStatus @default(COMPLETED)

  amount         Decimal @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  currency       String  @default("USD")

  receivedAt        DateTime @default(now())
  /// Free-form external reference (bank transfer ID, cheque number, terminal
  /// receipt, provider charge id …).
  externalReference String?
  notes             String?  @db.Text

  /// Who recorded the payment (userId). Plain string — mirrors ownerId fields.
  recordedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: an invoice with recorded payments must not be hard-deleted
  // (invoices are soft-deleted/voided anyway); financial records stay intact.
  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  installment  Installment?         @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  activities   PaymentActivity[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, receivedAt])
  @@index([invoiceId])
  @@index([installmentId])
  @@map("payments")
}

/// Append-only money-movement ledger under a payment. One CHARGE row is
/// written when the payment is recorded; each refund writes a REFUND row.
/// Rows are never updated or deleted — corrections are new entries. A future
/// payment-gateway adapter writes its captures/refunds here.
model PaymentTransaction {
  id        String @id @default(cuid())
  tenantId  String
  paymentId String

  type   PaymentTransactionType
  amount Decimal                @default(0) @db.Decimal(12, 2)

  /// Free-form external reference for this movement (provider txn id, etc.).
  reference String?
  notes     String?

  occurredAt DateTime @default(now())
  /// Who recorded the movement (userId). Nullable for system entries.
  createdBy  String?
  createdAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@map("payment_transactions")
}

/// Append-only timeline entry for a payment (who did what, when).
model PaymentActivity {
  id        String  @id @default(cuid())
  tenantId  String
  paymentId String
  userId    String?

  type        PaymentActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@map("payment_activities")
}

/// A reduction of an invoice's amount owed (goodwill, correction, partial
/// cancellation). ISSUED notes subtract from the balance due; voiding a note
/// restores it. Notes are never deleted — they are financial records.
model CreditNote {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "CN-2026-0001").
  reference String

  invoiceId String

  status CreditNoteStatus @default(ISSUED)
  amount Decimal          @default(0) @db.Decimal(12, 2)
  reason String?          @db.Text

  issuedAt DateTime  @default(now())
  voidedAt DateTime?

  /// Who issued the note (userId).
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("credit_notes")
}

/// A payment schedule for an invoice: an optional up-front deposit plus N
/// installments. The schedule amounts are generated cents-exact (they sum to
/// the invoice total precisely — see features/invoices/lib/installment-schedule.ts)
/// and captured at creation; a later invoice-total change requires recreating
/// the plan (enforced in the action layer: plans exist only on ISSUED invoices
/// whose lines are locked).
model InstallmentPlan {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String @unique

  /// Up-front deposit amount (0 = no deposit installment).
  depositAmount    Decimal @default(0) @db.Decimal(12, 2)
  /// Number of scheduled installments after the deposit.
  installmentCount Int

  notes String?

  /// Who created the plan (userId).
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([tenantId])
  @@map("installment_plans")
}

/// One scheduled amount within an installment plan. `sequence` 0 is the
/// deposit (when the plan has one); payments link back via `installmentId`
/// and the recording action marks the installment PAID once linked completed
/// payments cover `amount`.
model Installment {
  id       String @id @default(cuid())
  tenantId String
  planId   String

  sequence Int
  /// Display label ("Deposit", "Installment 1 of 4", …), captured at creation.
  label    String

  dueDate DateTime
  amount  Decimal  @default(0) @db.Decimal(12, 2)

  status InstallmentStatus @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([planId, sequence])
  @@index([tenantId])
  @@index([planId])
  @@map("installments")
}

// ---------------------------------------------------------------------------
// M4 Sprint 4 — Agency Operations
//
// The operational layer that makes a confirmed booking runnable by a real
// agency: traveller (PAX) records with passport/visa data, configurable
// cancellation policies with automatic refund calculation, per-line supplier
// confirmations, and printable service vouchers. Traveller document uploads
// deliberately add NO new model — they reuse the M3 polymorphic Document
// model (ownerType "traveller") and its UploadThing pipeline.
// ---------------------------------------------------------------------------

enum TravellerType {
  ADULT
  CHILD
  INFANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

/// Where a traveller's visa stands for the booked trip. UNKNOWN is the
/// honest default — agents set it once checked.
enum VisaStatus {
  UNKNOWN
  NOT_REQUIRED
  REQUIRED
  IN_PROGRESS
  OBTAINED
  DENIED
}

/// A traveller (PAX) on a booking. Owned by the booking — the same person on
/// two bookings is two rows, each a snapshot of what was true for that trip
/// (passports renew, requests differ). Exactly one traveller per booking is
/// primary (enforced in the action layer, not by the database). Document
/// scans (passport/visa/insurance/…) attach through the generic Document
/// model with ownerType "traveller".
model BookingTraveller {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String

  type      TravellerType @default(ADULT)
  isPrimary Boolean       @default(false)

  firstName   String
  lastName    String
  gender      Gender    @default(UNSPECIFIED)
  dateOfBirth DateTime?
  nationality String?

  passportNumber         String?
  passportIssuingCountry String?
  passportIssueDate      DateTime?
  passportExpiry         DateTime?

  visaStatus VisaStatus @default(UNKNOWN)
  visaNotes  String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  specialRequests String? @db.Text
  medicalNotes    String? @db.Text

  frequentFlyerAirline String?
  frequentFlyerNumber  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_travellers")
}

/// How a cancellation tier penalises: nothing (free window), a percentage of
/// the booking total, or a fixed amount.
enum CancellationPenaltyType {
  NONE
  PERCENTAGE
  FIXED
}

/// A tenant-configurable cancellation policy: an ordered set of tiers keyed
/// on how many days before travel the cancellation happens. Evaluation is a
/// pure function (features/cancellations/lib/cancellation-engine.ts); the
/// database only stores the tiers.
model CancellationPolicy {
  id       String @id @default(cuid())
  tenantId String

  name        String
  description String? @db.Text
  /// The tenant's default policy, offered first when assigning to a booking.
  isDefault   Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules         CancellationPolicyRule[]
  bookings      Booking[]
  cancellations BookingCancellation[]    @relation("CancellationRecordPolicy")

  @@index([tenantId])
  @@map("cancellation_policies")
}

/// One tier of a policy: applies when the cancellation occurs at least
/// `daysBefore` days before travel start. The engine picks the matching tier
/// with the highest `daysBefore`; a `daysBefore: 0` tier is the catch-all.
/// `penaltyValue` is a percent (0–100) for PERCENTAGE, an amount for FIXED,
/// ignored for NONE.
model CancellationPolicyRule {
  id       String @id @default(cuid())
  tenantId String
  policyId String

  daysBefore   Int
  penaltyType  CancellationPenaltyType @default(NONE)
  penaltyValue Decimal                 @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, daysBefore])
  @@index([tenantId])
  @@index([policyId])
  @@map("cancellation_policy_rules")
}

/// The immutable financial record written when a booking is cancelled: which
/// tier applied, the computed penalties, how much had been collected (net,
/// from the booking's invoices at that moment), and the refund due. The
/// actual money movement happens through the Sprint-3 payment refund flow —
/// this row documents what should be refunded and why.
model BookingCancellation {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String @unique

  policyId String?

  cancelledAt      DateTime @default(now())
  /// Days between cancellation and travel start; null when the booking had
  /// no travel start date (the catch-all tier applies).
  daysBeforeTravel Int?

  penaltyType     CancellationPenaltyType @default(NONE)
  penaltyValue    Decimal                 @default(0) @db.Decimal(12, 2)
  penaltyAmount   Decimal                 @default(0) @db.Decimal(12, 2)
  supplierPenalty Decimal                 @default(0) @db.Decimal(12, 2)
  /// Net collected across the booking's invoices at cancellation time.
  amountPaid      Decimal                 @default(0) @db.Decimal(12, 2)
  refundDue       Decimal                 @default(0) @db.Decimal(12, 2)

  reason String?
  notes  String? @db.Text

  /// Who cancelled (userId).
  cancelledBy String?
  createdAt   DateTime @default(now())

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // SetNull: deleting a policy must not erase the historical cancellation.
  policy  CancellationPolicy? @relation("CancellationRecordPolicy", fields: [policyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("booking_cancellations")
}

/// Whether the supplier has confirmed the service behind a booking line.
enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// A supplier's answer for one booking line (hotel room, activity, transfer,
/// guide, flight). At most one per line (`bookingItemId` unique).
/// `supplierName` is captured text, FK-free like BookingItem.referenceId —
/// inventory can change without rewriting operational history.
model SupplierConfirmation {
  id            String @id @default(cuid())
  tenantId      String
  bookingId     String
  bookingItemId String @unique

  status             ConfirmationStatus @default(PENDING)
  supplierName       String?
  confirmationNumber String?

  requestedAt DateTime  @default(now())
  respondedAt DateTime?

  notes     String?
  /// Who recorded the request/response (userId).
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item    BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@map("supplier_confirmations")
}

enum VoucherStatus {
  ISSUED
  CANCELLED
}

/// A printable operational voucher for one service on a booking. Everything
/// on it is a snapshot captured at issue time (traveller names, supplier,
/// dates, service text) so later booking edits never silently rewrite a
/// voucher already in a customer's hands — reissue instead. `qrData` is the
/// payload a QR renderer will encode; the UI shows a placeholder until a
/// real QR library lands.
model Voucher {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "VCH-2026-0001").
  reference String

  bookingId     String
  bookingItemId String?

  type   BookingItemType
  status VoucherStatus   @default(ISSUED)

  supplierName       String?
  serviceDescription String
  serviceStartDate   DateTime?
  serviceEndDate     DateTime?
  travellerNames     String[]
  confirmationNumber String?

  qrData String

  notes String? @db.Text

  issuedAt    DateTime  @default(now())
  cancelledAt DateTime?
  /// Who issued it (userId).
  issuedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // SetNull: removing a line must not destroy an already-issued voucher.
  bookingItem BookingItem? @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([bookingId])
  @@map("vouchers")
}

// ---------------------------------------------------------------------------
// Supplier Order Execution Capability — a generic engine for turning a
// validated booking line into a real, externally confirmed supplier order.
// Duffel is the first provider implementation; the two models below are
// provider-agnostic. See PROJECT.md, "Supplier Order Execution Capability".
// ---------------------------------------------------------------------------

/// Adding a supplier is a new adapter implementing `SupplierExecutionProvider`
/// (src/features/supplier-execution) plus one `ALTER TYPE ADD VALUE`
/// migration — not a change to either model below. Hotelbeds (Hotelbeds
/// Execution Capability sprint) is the second implementation, proving Duffel
/// was never the architecture, just the first adapter.
enum SupplierOrderProvider {
  DUFFEL
  HOTELBEDS
}

enum SupplierOrderStatus {
  /// Created, not yet attempted — the moment a line is "Validated".
  PENDING
  /// The optimistic-lock claim is held; a supplier call is in flight.
  EXECUTING
  /// A real supplier order exists.
  SUPPLIER_CONFIRMED
  /// The last attempt failed. `retryable` says whether another attempt may help.
  SUPPLIER_FAILED
  /// A HOLD order was placed (fare reserved, no money moved yet) and still
  /// needs its separate "pay for this order" step — not implemented this
  /// sprint (see PROJECT.md gap analysis); the state exists so the engine
  /// never has to pretend a hold is the same as a paid order.
  AWAITING_PAYMENT
  /// The supplier accepted the request but hasn't given a final answer yet —
  /// Hotelbeds' "ON REQUEST"/"PENDING" bookings (some rates need the supplier
  /// to check with the property before confirming). Generic, not Hotelbeds-
  /// specific: any provider with an async confirmation step lands here. Like
  /// AWAITING_PAYMENT, modeled but not auto-resolved this sprint — resolving
  /// it needs polling or a webhook (Platform Automation Capability's named,
  /// deferred gap), so a human currently checks the supplier's own dashboard
  /// and this stays visible-but-manual in the UI until that exists.
  AWAITING_SUPPLIER_CONFIRMATION
  CANCELLED
  /// Our own write of the outcome failed after the supplier call completed
  /// — the local and remote state may disagree. Never auto-retried (retrying
  /// a possibly-already-successful purchase risks a second real order);
  /// requires a human to reconcile against the supplier's own dashboard.
  RECONCILIATION_REQUIRED
}

/// Whether an order is a reserved-but-unpaid hold or was purchased against
/// the tenant's own pre-funded supplier balance. TravelOS never processes a
/// card here — HOLD moves no money; BALANCE debits an account the agency
/// funds directly with the supplier, outside TravelOS.
enum SupplierPaymentMode {
  HOLD
  BALANCE
}

enum SupplierOrderEventType {
  REQUESTED
  ATTEMPT_STARTED
  SUPPLIER_CONFIRMED
  SUPPLIER_FAILED
  RETRY_REQUESTED
  CANCELLED
  RECONCILIATION_FLAGGED
  /// One status-check attempt against the supplier for an
  /// AWAITING_SUPPLIER_CONFIRMATION order (Hotelbeds "ON REQUEST") —
  /// written whether or not the status actually changed, so "repeated
  /// polling, nothing new yet" has its own visible trail. See
  /// PROJECT.md, "Booking Status Resolution Capability".
  STATUS_CHECKED
}

/// Current execution state for one booking line's supplier order — 1:1 with
/// BookingItem, the same shape SupplierConfirmation already uses. On
/// SUPPLIER_CONFIRMED, the engine updates the linked SupplierConfirmation
/// row (real confirmationNumber) rather than duplicating it — this model
/// is the machine-driven execution record; SupplierConfirmation stays the
/// human-facing "is this line confirmed" summary already wired into the UI
/// and vouchers.
model SupplierOrder {
  id            String @id @default(cuid())
  tenantId      String
  bookingId     String
  bookingItemId String @unique

  provider SupplierOrderProvider
  status   SupplierOrderStatus   @default(PENDING)

  /// Our own concurrency guard, unique per line — prevents two overlapping
  /// executions (a double-click, a retried request) for the same booking
  /// item. Not a Duffel-side idempotency key; see PROJECT.md, "Idempotency".
  idempotencyKey String @unique

  /// The offer/rate this execution was built from (Duffel offer id today).
  supplierOfferRef String

  /// Set once the supplier confirms — the real order id and the
  /// human-readable confirmation/booking reference (may differ per supplier).
  supplierOrderId    String?
  confirmationNumber String?

  paymentMode SupplierPaymentMode @default(HOLD)

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  /// Safe-to-display summary of the last failure, if any.
  lastError     String?
  /// Whether the last failure is worth retrying — drives whether the UI
  /// offers "Retry". Null until a failure has occurred.
  retryable     Boolean?

  requestedAt DateTime  @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?

  /// Who requested execution (userId).
  requestedBy  String?
  /// True when execution was allowed to proceed against a booking whose
  /// linked invoice(s) are not fully settled — an explicit, audited
  /// override (see PROJECT.md, "soft precondition"), never silent.
  paidOverride Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item    BookingItem          @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  events  SupplierOrderEvent[]

  @@index([tenantId])
  @@index([bookingId])
  @@index([tenantId, status])
  @@map("supplier_orders")
}

/// Append-only attempt/transition log under a SupplierOrder — the same
/// relationship PaymentTransaction has to Payment. Rows are never updated
/// or deleted; a correction is a new row.
model SupplierOrderEvent {
  id              String @id @default(cuid())
  tenantId        String
  supplierOrderId String

  type     SupplierOrderEventType
  message  String
  /// Provider request/response metadata for debugging — never raw
  /// credentials, and payloads are truncated before storage (see the
  /// engine's event-writer, not this schema).
  metadata Json?

  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierOrderId])
  @@map("supplier_order_events")
}

/// A job's `status` never rests at a failure value — a retryable failure
/// goes straight back to PENDING with `availableAt` pushed forward, the
/// same "no separate transient-failure state" choice `SupplierOrder` makes
/// with its `retryable` flag rather than a dedicated status. Only terminal
/// outcomes (SUCCEEDED, DEAD_LETTER, CANCELLED) leave PENDING/RUNNING.
enum JobStatus {
  /// Claimable once `availableAt` has passed — includes both a fresh job
  /// and one waiting to retry after a failure.
  PENDING
  /// The atomic claim (`updateMany` keyed on id+status, see PROJECT.md
  /// "Platform Automation Capability") is held; a handler is executing.
  RUNNING
  SUCCEEDED
  /// Retries exhausted (or the failure was classified non-retryable).
  /// Never auto-requeued — the same fail-loud, human-must-look precedent
  /// as SupplierOrder's RECONCILIATION_REQUIRED.
  DEAD_LETTER
  CANCELLED
}

enum JobEventType {
  ENQUEUED
  CLAIMED
  SUCCEEDED
  RETRY_SCHEDULED
  DEAD_LETTERED
  CANCELLED
}

/// The queue table, doubling as the durable "what needs to run" record —
/// no separate in-memory or external queue exists (see PROJECT.md, "why a
/// table is the queue"). `type` is a lookup key into the handler registry
/// (`src/features/automation/lib/registry.ts`); a new asynchronous
/// capability is a new `type` string and a registered handler, never a
/// change to this model or the worker.
model Job {
  id       String  @id @default(cuid())
  /// Nullable: most jobs act on behalf of one tenant (and are tenant-scoped
  /// through the same guarded client as every other model here), but a
  /// platform-level job (a future cross-tenant report, say) has none —
  /// mirrors `AuditLog.tenantId`, the one other model with this shape.
  tenantId String?

  type    String
  payload Json

  status   JobStatus @default(PENDING)
  /// Higher runs first among otherwise-claimable jobs. Default 0.
  priority Int       @default(0)

  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  /// Not claimable until now() reaches this — both the initial scheduling
  /// delay and where a retry's backoff lands.
  availableAt DateTime  @default(now())
  lockedAt    DateTime?

  /// Safe-to-display summary of the most recent failure, if any.
  lastError String?

  /// Optional caller-supplied dedupe key — a second `enqueueJob` call with
  /// the same key joins the existing row instead of creating a duplicate.
  /// See PROJECT.md, "Idempotency" (the same unique-constraint-plus-P2002
  /// pattern `SupplierOrder.idempotencyKey` established).
  idempotencyKey String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  tenant Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events JobEvent[]

  @@index([status, availableAt])
  @@index([tenantId])
  @@index([type])
  @@map("jobs")
}

/// Append-only attempt/transition log under a Job — the same relationship
/// SupplierOrderEvent has to SupplierOrder. This is the job system's
/// observability trail; there is no separate metrics/tracing system this
/// sprint (see PROJECT.md gap analysis).
model JobEvent {
  id       String  @id @default(cuid())
  tenantId String?
  jobId    String

  type     JobEventType
  message  String?
  metadata Json?

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([jobId])
  @@map("job_events")
}

// ---------------------------------------------------------------------------
// Customer Portal Capability — a separate, session-less-by-default auth
// boundary for travelers. A Customer has no login credential anywhere else
// in this schema (no password, no Auth.js User/Membership row) — deliberately:
// an agency's own staff auth (User/Membership/Auth.js) must never be
// reachable by a traveler, so the portal gets its own two-model credential
// chain instead of reusing/widening the staff one. Mirrors the shape
// Invitation already proved out (a high-entropy bearer `token` column,
// distinct from the row's own `id`, with its own expiry) rather than
// inventing a new pattern. See PROJECT.md, "Customer Portal Capability".
// ---------------------------------------------------------------------------

/// The emailed, single-use credential a traveler exchanges for a
/// `PortalSession`. Scoped to a `Customer`, not a single `Booking` — the
/// resulting session sees every booking that customer has with this tenant
/// (see PROJECT.md for why "prove you know one real booking" is still the
/// right entry gate even though the grant is customer-wide). Short-lived
/// (15 minutes) and single-use (`consumedAt`) by design: this token only
/// ever needs to survive the time between "check email" and "click link".
model PortalMagicLink {
  id         String @id @default(cuid())
  tenantId   String
  customerId String

  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  /// The booking reference the requester proved knowledge of — kept for the
  /// audit trail, not re-checked at consume time (the token itself is now
  /// the credential).
  requestedBookingReference String
  requestIp                 String?

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("portal_magic_links")
}

/// The traveler's signed-in session, backing an httpOnly cookie that stores
/// only this row's bearer `token` (never `id` — same id/token split as
/// `PortalMagicLink` and `Invitation`). Revocable (`revokedAt`, e.g. "sign
/// out everywhere") and fixed-TTL (14 days from creation — not a sliding
/// window, so a stolen cookie doesn't grant indefinite access as long as it
/// stays in occasional use).
model PortalSession {
  id         String @id @default(cuid())
  tenantId   String
  customerId String

  token     String   @unique
  expiresAt DateTime

  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  /// Captured at session creation for the security audit trail — never
  /// used as an authorization input.
  createdIp String?
  userAgent String?

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("portal_sessions")
}
