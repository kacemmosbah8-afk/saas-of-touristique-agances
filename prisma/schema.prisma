// TravelOS — core data model (Milestone M0)
//
// Multi-tenancy strategy: shared schema, shared tables, every tenant-scoped
// model carries a `tenantId` column. Enforcement happens at two independent
// layers:
//   1. Application layer — `src/shared/lib/db.ts` exposes a tenant-scoped
//      Prisma Client Extension that injects `tenantId` into every query for
//      tenant-scoped models.
//   2. Database layer — Postgres Row-Level Security policies (see
//      prisma/sql/001_row_level_security.sql) as defense-in-depth.
//
// No business-domain models (bookings, itineraries, CRM, finance, ...) are
// defined yet — those belong to their own milestones. M0 only ships the
// identity, tenancy, and audit backbone every future feature builds on.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A travel agency. The root of every tenant-scoped relation in the system.
model Tenant {
  id   String @id @default(cuid())
  /// URL-safe identifier used for path-based tenant resolution: /app/[slug]/...
  slug String @unique
  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships         Membership[]
  invitations         Invitation[]
  auditLogs           AuditLog[]
  packages            Package[]
  packageImages       PackageImage[]
  itineraryDays       ItineraryDay[]
  itineraryActivities ItineraryActivity[]

  // M2 — Suppliers & Inventory
  hotels             Hotel[]
  hotelImages        HotelImage[]
  roomTypes          RoomType[]
  transportProviders TransportProvider[]
  guides             Guide[]
  suppliers          Supplier[]
  supplierDocuments  SupplierDocument[]
  activities         Activity[]
  activityImages     ActivityImage[]
  destinations       Destination[]
  destinationImages  DestinationImage[]
  packageHotels      PackageHotel[]
  packageActivities  PackageActivity[]
  packageGuides      PackageGuide[]
  packageTransport   PackageTransport[]
  packageSuppliers   PackageSupplier[]

  // M3 — CRM, Leads, Documents, Providers, Settings
  customers             Customer[]
  companies             Company[]
  tags                  Tag[]
  leads                 Lead[]
  documents             Document[]
  communicationMessages CommunicationMessage[]
  providers             Provider[]
  travelCategories      TravelCategory[]
  customFields          CustomField[]
  settings              TenantSettings?
  paymentConfigurations PaymentConfiguration[]

  // M3 — imported reference data
  importedCountries Country[]
  importedCities    City[]
  importedAirports  Airport[]
  importedAirlines  Airline[]
  importedAmenities Amenity[]

  // M4 — Booking Engine
  bookings          Booking[]
  bookingItems      BookingItem[]
  bookingActivities BookingActivity[]

  // M4 Sprint 2 — Pricing & Quotes
  quotes          Quote[]
  quoteItems      QuoteItem[]
  quoteActivities QuoteActivity[]

  // M4 Sprint 3 — Invoicing & Payments
  invoices            Invoice[]
  invoiceItems        InvoiceItem[]
  invoiceActivities   InvoiceActivity[]
  payments            Payment[]
  paymentTransactions PaymentTransaction[]
  paymentActivities   PaymentActivity[]
  creditNotes         CreditNote[]
  installmentPlans    InstallmentPlan[]
  installments        Installment[]

  // M4 Sprint 4 — Agency Operations
  bookingTravellers       BookingTraveller[]
  cancellationPolicies    CancellationPolicy[]
  cancellationPolicyRules CancellationPolicyRule[]
  bookingCancellations    BookingCancellation[]
  supplierConfirmations   SupplierConfirmation[]
  vouchers                Voucher[]

  // Supplier Order Execution Capability
  supplierOrders      SupplierOrder[]
  supplierOrderEvents SupplierOrderEvent[]

  // Platform Automation Capability
  jobs      Job[]
  jobEvents JobEvent[]

  // Customer Portal Capability
  portalMagicLinks PortalMagicLink[]
  portalSessions   PortalSession[]

  @@map("tenants")
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
  ACCOUNTANT
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Links a User to a Tenant with a role. A user may belong to more than one
/// agency (e.g. a freelance consultant working with multiple shops).
model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  role   MembershipRole
  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("memberships")
}

/// A pending invite for someone (existing user or not) to join a Tenant.
model Invitation {
  id       String         @id @default(cuid())
  tenantId String
  email    String
  role     MembershipRole

  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Packages
// ---------------------------------------------------------------------------

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PackageDifficulty {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
}

/// A travel package offered by a tenant.
model Package {
  id       String @id @default(cuid())
  tenantId String
  name     String
  slug     String

  // Core details
  shortDescription String?
  description      String?            @db.Text
  destination      String?
  country          String?
  duration         Int?
  durationNights   Int?
  category         String?
  difficulty       PackageDifficulty?
  featured         Boolean            @default(false)

  // Media
  coverImageKey String?
  coverImageUrl String?

  // Builder sections (stored as PostgreSQL TEXT arrays)
  highlights       String[]
  includedServices String[]
  excludedServices String[]
  importantNotes   String[]
  whatToBring      String[]

  // Builder text sections
  cancellationPolicy String? @db.Text
  meetingPoint       String?

  // SEO
  seoTitle       String?
  seoDescription String?

  status    PackageStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images        PackageImage[]
  itineraryDays ItineraryDay[]

  // M2 — inventory relationships
  packageHotels     PackageHotel[]
  packageActivities PackageActivity[]
  packageGuides     PackageGuide[]
  packageTransport  PackageTransport[]
  packageSuppliers  PackageSupplier[]

  // M4 — Booking Engine
  bookings Booking[]

  // M4 Sprint 2 — Pricing & Quotes
  quotes Quote[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("packages")
}

/// Individual gallery image belonging to a package.
model PackageImage {
  id        String  @id @default(cuid())
  tenantId  String
  packageId String
  fileKey   String
  url       String
  alt       String?
  position  Int     @default(0)

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([packageId, position])
  @@map("package_images")
}

// ---------------------------------------------------------------------------
// Itinerary
// ---------------------------------------------------------------------------

/// A single day in a package itinerary. Days are ordered by `dayNumber`.
model ItineraryDay {
  id        String @id @default(cuid())
  tenantId  String
  packageId String

  dayNumber   Int
  title       String
  description String? @db.Text
  notes       String? @db.Text

  // Meals (free-text notes per meal slot)
  mealBreakfast String?
  mealLunch     String?
  mealDinner    String?

  // Logistics
  transferNotes      String? @db.Text
  accommodationNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package    Package             @relation(fields: [packageId], references: [id], onDelete: Cascade)
  activities ItineraryActivity[]

  @@unique([packageId, dayNumber])
  @@index([tenantId])
  @@index([packageId, dayNumber])
  @@map("itinerary_days")
}

/// An activity within a single itinerary day. Activities are ordered by `position`.
model ItineraryActivity {
  id       String @id @default(cuid())
  tenantId String
  dayId    String

  position    Int     @default(0)
  title       String
  description String? @db.Text
  duration    Int? // minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day    ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dayId, position])
  @@map("itinerary_activities")
}

// ---------------------------------------------------------------------------
// Suppliers & Inventory (Milestone M2)
//
// Shared resource lifecycle: `ResourceStatus` models the active/inactive state
// of a supplier resource, while `deletedAt` is a soft-delete tombstone. Lists
// always filter `deletedAt: null`; "Archive/Restore" flips status, "Delete"
// sets the tombstone. Money is stored as Decimal(12,2) and converted to plain
// numbers in query mappers so it can cross the Server→Client boundary.
// ---------------------------------------------------------------------------

enum ResourceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Hotels
// ---------------------------------------------------------------------------

enum HotelCategory {
  BUDGET
  STANDARD
  BOUTIQUE
  LUXURY
  RESORT
  RIAD
  GUESTHOUSE
  HOSTEL
}

enum RoomTypeKind {
  STANDARD
  DELUXE
  SUITE
  FAMILY
  CUSTOM
}

/// A hotel a tenant works with. Not booking inventory yet — a catalogue entry
/// that packages can later reference.
model Hotel {
  id       String @id @default(cuid())
  tenantId String
  name     String

  category HotelCategory @default(STANDARD)
  stars    Int?

  country   String?
  city      String?
  address   String?
  latitude  Float?
  longitude Float?

  description String?  @db.Text
  amenities   String[]

  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?

  internalNotes String? @db.Text

  coverImageKey String?
  coverImageUrl String?

  /// Set when imported from an external provider via the sync system.
  source       ProviderType?
  externalCode String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images        HotelImage[]
  roomTypes     RoomType[]
  packageHotels PackageHotel[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, country, city])
  @@index([tenantId, source, externalCode])
  @@map("hotels")
}

model HotelImage {
  id       String  @id @default(cuid())
  tenantId String
  hotelId  String
  /// Nullable: an UploadThing-hosted image has a real fileKey; an image
  /// synced from a content provider (source/externalCode on the parent
  /// Hotel) is a direct external URL with no local file, so this is null.
  fileKey  String?
  url      String
  alt      String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotel  Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hotelId, position])
  @@map("hotel_images")
}

/// A room category within a Hotel. Room images are stored as a flat array of
/// URLs (simpler than a join table for what is effectively a small gallery).
model RoomType {
  id       String @id @default(cuid())
  tenantId String
  hotelId  String

  kind RoomTypeKind @default(STANDARD)
  name String

  capacity  Int  @default(2)
  beds      Int?
  occupancy Int?

  basePrice    Decimal? @db.Decimal(12, 2)
  internalCost Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  images String[]
  notes  String?  @db.Text

  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotel  Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hotelId, position])
  @@map("room_types")
}

// ---------------------------------------------------------------------------
// Transportation
// ---------------------------------------------------------------------------

enum TransportType {
  AIRPORT_TRANSFER
  BUS
  PRIVATE
  CAR_RENTAL
  BOAT
  CUSTOM
}

model TransportProvider {
  id       String @id @default(cuid())
  tenantId String
  name     String

  type TransportType @default(PRIVATE)

  country String?
  city    String?

  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?

  fleetNotes    String? @db.Text
  pricingNotes  String? @db.Text
  internalNotes String? @db.Text

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageTransport PackageTransport[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("transport_providers")
}

// ---------------------------------------------------------------------------
// Tour Guides
// ---------------------------------------------------------------------------

model Guide {
  id       String @id @default(cuid())
  tenantId String
  name     String

  languages       String[]
  certifications  String[]
  experienceYears Int?

  dailyRate Decimal? @db.Decimal(12, 2)
  currency  String   @default("USD")

  country String?
  city    String?

  contactEmail String?
  contactPhone String?

  availabilityNotes String? @db.Text
  internalNotes     String? @db.Text

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageGuides PackageGuide[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("guides")
}

// ---------------------------------------------------------------------------
// Suppliers
// ---------------------------------------------------------------------------

enum SupplierType {
  HOTEL
  FLIGHT
  TRANSPORT
  ACTIVITY
  RESTAURANT
  GUIDE
  VISA
  INSURANCE
  OTHER
}

model Supplier {
  id       String @id @default(cuid())
  tenantId String
  name     String

  type SupplierType @default(OTHER)

  contactName String?
  email       String?
  phone       String?
  website     String?
  address     String?
  country     String?
  city        String?

  paymentTerms   String?
  /// Internal rating 1–5. Null when unrated.
  internalRating Int?

  /// Commission percentage the tenant earns from this supplier (0–100).
  commissionRate  Decimal? @db.Decimal(5, 2)
  commissionNotes String?

  notes String? @db.Text

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents        SupplierDocument[]
  contacts         SupplierContact[]
  packageSuppliers PackageSupplier[]
  activities       Activity[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("suppliers")
}

/// Contracts and other files attached to a supplier. `kind` distinguishes
/// contracts from generic documents without a separate table.
model SupplierDocument {
  id         String @id @default(cuid())
  tenantId   String
  supplierId String

  name    String
  kind    String @default("document")
  fileKey String
  url     String

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierId])
  @@map("supplier_documents")
}

// ---------------------------------------------------------------------------
// Activities
// ---------------------------------------------------------------------------

model Activity {
  id       String @id @default(cuid())
  tenantId String
  name     String

  category        String?
  durationMinutes Int?
  meetingPoint    String?

  description   String?  @db.Text
  includedItems String[]
  excludedItems String[]

  country String?
  city    String?

  supplierId String?

  internalCost Decimal? @db.Decimal(12, 2)
  sellingPrice Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")

  coverImageKey String?
  coverImageUrl String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images            ActivityImage[]
  packageActivities PackageActivity[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([supplierId])
  @@map("activities")
}

model ActivityImage {
  id         String  @id @default(cuid())
  tenantId   String
  activityId String
  fileKey    String
  url        String
  alt        String?
  position   Int     @default(0)

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([activityId, position])
  @@map("activity_images")
}

// ---------------------------------------------------------------------------
// Destinations
// ---------------------------------------------------------------------------

model Destination {
  id       String @id @default(cuid())
  tenantId String
  name     String

  country String
  region  String?
  city    String?

  description String? @db.Text

  heroImageKey String?
  heroImageUrl String?

  popularAttractions String[]

  seoTitle       String?
  seoDescription String?

  /// Set when imported from an external content provider via sync —
  /// mirrors Hotel.source/externalCode exactly. Null for agency-authored
  /// destinations (the pre-existing, unaffected write path).
  source       ProviderType?
  externalCode String?

  status    ResourceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gallery DestinationImage[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, country])
  @@index([tenantId, source, externalCode])
  @@map("destinations")
}

model DestinationImage {
  id            String  @id @default(cuid())
  tenantId      String
  destinationId String
  /// Nullable for the same reason as HotelImage.fileKey — a synced image
  /// has no local UploadThing file.
  fileKey       String?
  url           String
  alt           String?
  position      Int     @default(0)

  createdAt DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([destinationId, position])
  @@map("destination_images")
}

// ---------------------------------------------------------------------------
// Package inventory relationships (Modules 7 & 8)
//
// Join tables linking a Package to the resources it uses. `position` supports
// drag-and-drop ordering within each resource group. No booking/pricing logic
// yet — only the relationships.
// ---------------------------------------------------------------------------

model PackageHotel {
  id        String @id @default(cuid())
  tenantId  String
  packageId String
  hotelId   String

  position Int     @default(0)
  notes    String?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([packageId, hotelId])
  @@index([tenantId])
  @@index([packageId, position])
  @@map("package_hotels")
}

model PackageActivity {
  id         String @id @default(cuid())
  tenantId   String
  packageId  String
  activityId String

  position Int     @default(0)
  notes    String?

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([packageId, activityId])
  @@index([tenantId])
  @@index([packageId, position])
  @@map("package_activities")
}

model PackageGuide {
  id        String @id @default(cuid())
  tenantId  String
  packageId String
  guideId   String

  position Int     @default(0)
  notes    String?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  guide   Guide   @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([packageId, guideId])
  @@index([tenantId])
  @@index([packageId, position])
  @@map("package_guides")
}

model PackageTransport {
  id                  String @id @default(cuid())
  tenantId            String
  packageId           String
  transportProviderId String

  position Int     @default(0)
  notes    String?

  createdAt DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package  Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  provider TransportProvider @relation(fields: [transportProviderId], references: [id], onDelete: Cascade)

  @@unique([packageId, transportProviderId])
  @@index([tenantId])
  @@index([packageId, position])
  @@map("package_transport")
}

model PackageSupplier {
  id         String @id @default(cuid())
  tenantId   String
  packageId  String
  supplierId String

  position Int     @default(0)
  notes    String?

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([packageId, supplierId])
  @@index([tenantId])
  @@index([packageId, position])
  @@map("package_suppliers")
}

// ===========================================================================
// M3 — CRM, Leads, Documents, Providers, Settings
//
// Owner/author references (ownerId, authorId, userId, uploadedById) are stored
// as plain String user ids rather than Prisma relations: they are display
// attribution, not integrity-critical, and keeping them off the User model
// avoids a dozen back-relations on an identity table. Child rows carry a
// `tenantId` column for the tenant-scoped client + RLS but cascade-delete
// through their parent, so only top-level entities declare a `Tenant` relation.
// ===========================================================================

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  CORPORATE
  AGENCY
  VIP
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  ADVERTISING
  WALK_IN
  PHONE
  EMAIL
  PARTNER
  OTHER
}

enum CommunicationPreference {
  EMAIL
  PHONE
  SMS
  WHATSAPP
  NONE
}

enum CustomerActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  EMAIL
  CALL
  MEETING
  TAG_ADDED
  CONVERTED
  OTHER
}

model Customer {
  id       String @id @default(cuid())
  tenantId String

  firstName String
  lastName  String
  email     String?
  phone     String?

  type   CustomerType   @default(INDIVIDUAL)
  status ResourceStatus @default(ACTIVE)

  leadSource              LeadSource?
  communicationPreference CommunicationPreference @default(EMAIL)

  dateOfBirth    DateTime?
  nationality    String?
  passportNumber String?
  passportExpiry DateTime?

  notes String? @db.Text

  companyId String?
  /// Assigned account manager (userId). Plain string — see header note.
  ownerId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  addresses     Address[]
  customerTags  CustomerTag[]
  customerNotes CustomerNote[]
  activities    CustomerActivity[]
  leads         Lead[]
  bookings      Booking[]
  quotes        Quote[]
  invoices      Invoice[]

  // Customer Portal Capability
  portalMagicLinks PortalMagicLink[]
  portalSessions   PortalSession[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
