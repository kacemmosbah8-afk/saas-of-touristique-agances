  supplierSettings    Json?
  providerSettings    Json?
  /// Universal Pricing Engine's tenant policy — { default, overrides } per
  /// features/pricing/schemas/pricing.schema.ts. Same "Json column,
  /// Zod-validated at every read/write boundary" convention as the other
  /// per-module settings columns above; a new pricing component type is a
  /// new literal in that schema, never a migration here.
  pricingSettings     Json?
  /// TravelPayouts Content Synchronization Engine's per-tenant config —
  /// { enabled, intervalMinutes, datasets } per
  /// features/content-sync/schemas/content-sync.schema.ts. Same per-module
  /// Json-column convention as every settings field above.
  contentSyncSettings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
