// ---------------------------------------------------------------------------
// Identity (Auth.js)
// ---------------------------------------------------------------------------

/// A person. Deliberately tenant-agnostic — tenancy lives on Membership.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  /// Set only for the Credentials provider. Null for OAuth-only users.
  passwordHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("users")
}

/// Required by @auth/prisma-adapter for OAuth account linking.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Required by @auth/prisma-adapter's type contract. Unused for reads/writes
/// of the active session under the JWT session strategy (see auth strategy in
/// PROJECT.md) but kept so the adapter type-checks and so we can switch to
/// database sessions later without a schema migration.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of who changed what. Required from day one because
/// booking/finance data (added in later milestones) needs a defensible trail.
model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  userId   String?

  action   String
  entity   String
  entityId String?
  metadata Json?

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// M4 — Booking Engine (Sprint 1: core reservations, no payments/invoicing yet)
// ---------------------------------------------------------------------------

/// Lifecycle of a booking. Deliberately excludes payment states — invoicing
/// and payments are a later sprint. DRAFT is the working state; CONFIRMED
/// locks the reservation; IN_PROGRESS/COMPLETED track fulfilment; CANCELLED
/// is terminal. Allowed transitions are enforced in the domain layer
/// (features/bookings/lib/status.ts), not by the database.
enum BookingStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// The category of a booking line item. Mirrors the inventory modules so a
/// line can optionally point back at a Hotel/Activity/Guide/Transport record
/// via `referenceId`, plus FLIGHT (external providers) and free-form OTHER.
enum BookingItemType {
  HOTEL
  TRANSPORT
  ACTIVITY
  GUIDE
  FLIGHT
  PACKAGE
  OTHER
}

/// Timeline event types for a booking, mirroring the CRM/Leads activity feeds.
enum BookingActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  CANCELLED
  NOTE
}

/// A reservation for a customer. Monetary columns (`subtotal`/`total`) are
/// derived from `items` and recomputed whenever items or discount/tax change
/// — they are stored (not computed on read) so list/report queries stay cheap
/// and a booking's recorded price is stable even if inventory prices move.
model Booking {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "BK-2026-0001").
  reference String

  customerId String
  packageId  String?
  /// Assigned agent (userId). Plain string — see header note on ownerId.
  ownerId    String?

  status BookingStatus @default(DRAFT)

  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(1)
  children        Int       @default(0)

  currency String  @default("USD")
  /// Sum of item amounts. Recomputed by the domain layer on every item change.
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  /// subtotal - discount + tax. Recomputed alongside subtotal.
  total    Decimal @default(0) @db.Decimal(12, 2)

  notes         String? @db.Text
  internalNotes String? @db.Text

  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: a customer with bookings cannot be hard-deleted out from under
  // them (customers are soft-deleted anyway); keeps the reservation's owner intact.
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package    Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  items      BookingItem[]
  activities BookingActivity[]
  // M4 Sprint 2 — the quote this booking was converted from, if any.
  quote      Quote?
  // M4 Sprint 3 — invoices generated from this booking (deposit + balance
  // invoices are separate records, so this is a list, not a unique link).
  invoices   Invoice[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([customerId])
  @@index([packageId])
  @@map("bookings")
}

/// A single priced line on a booking. `referenceId` is an optional, FK-free
/// pointer to the inventory record the line was drawn from — intentionally not
/// a foreign key so inventory can be edited/removed without rewriting historical
/// bookings (the line keeps its captured `description`/`unitPrice`).
model BookingItem {
  id        String @id @default(cuid())
  tenantId  String
  bookingId String

  type        BookingItemType
  description String
  referenceId String?

  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice, captured at write time.
  amount    Decimal @default(0) @db.Decimal(12, 2)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_items")
}

/// Append-only timeline entry for a booking (who did what, when).
model BookingActivity {
  id        String  @id @default(cuid())
  tenantId  String
  bookingId String
  /// Actor. Nullable so system-generated events don't require a user.
  userId    String?

  type        BookingActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_activities")
}

// ---------------------------------------------------------------------------
// M4 Sprint 2 — Pricing & Quotes
//
// A Quote is the pre-sale proposal that precedes a Booking: a priced offer
// sent to a customer that, once ACCEPTED, converts one-to-one into a Booking.
// It reuses the exact money model as bookings (stored integer-cents-derived
// Decimal totals, recomputed from lines) and the same line taxonomy
// (BookingItemType) so a quote line maps directly onto a booking line at
// conversion. Transitions are enforced in the domain layer
// (features/quotes/lib/quote-status.ts), not by the database.
// ---------------------------------------------------------------------------

/// Lifecycle of a quote. DRAFT is the working state; SENT is delivered to the
/// customer; ACCEPTED/DECLINED capture the customer's decision; EXPIRED is set
/// once `validUntil` passes without acceptance; CONVERTED is terminal and means
/// the quote was turned into a Booking. Allowed transitions live in the domain
/// layer.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

/// Timeline event types for a quote, mirroring the booking activity feed.
enum QuoteActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  ASSIGNED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  NOTE
}

/// A priced proposal for a customer. Monetary columns are stored (not computed
/// on read), recomputed from `items` + discount/tax on every change — identical
/// discipline to Booking. `convertedBookingId` links a CONVERTED quote to the
/// Booking it produced (unique: a quote converts at most once).
model Quote {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "QT-2026-0001").
  reference String

  customerId String
  packageId  String?
  /// Assigned agent (userId). Plain string — mirrors Booking.ownerId.
  ownerId    String?

  status QuoteStatus @default(DRAFT)

  /// The offer's expiry. Past this date the quote may be moved to EXPIRED.
  validUntil      DateTime?
  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(1)
  children        Int       @default(0)

  currency String  @default("USD")
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  /// Customer-facing proposal notes and terms (shown on the quote).
  notes         String? @db.Text
  terms         String? @db.Text
  internalNotes String? @db.Text

  sentAt      DateTime?
  acceptedAt  DateTime?
  declinedAt  DateTime?
  convertedAt DateTime?

  /// Set when the quote is converted into a booking (terminal CONVERTED state).
  convertedBookingId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package          Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  // The booking produced by converting this quote. SetNull: deleting that
  // booking must not delete the historical quote record.
  convertedBooking Booking?        @relation(fields: [convertedBookingId], references: [id], onDelete: SetNull)
  items            QuoteItem[]
  activities       QuoteActivity[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([customerId])
  @@index([packageId])
  @@map("quotes")
}

/// A single priced line on a quote. Same shape as BookingItem so conversion is
/// a direct field copy. `referenceId` is an FK-free pointer to the inventory
/// record the line/price was drawn from (see the pricing catalog query).
model QuoteItem {
  id       String @id @default(cuid())
  tenantId String
  quoteId  String

  type        BookingItemType
  description String
  referenceId String?

  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice, captured at write time.
  amount    Decimal @default(0) @db.Decimal(12, 2)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("quote_items")
}

/// Append-only timeline entry for a quote (who did what, when).
model QuoteActivity {
  id       String  @id @default(cuid())
  tenantId String
  quoteId  String
  /// Actor. Nullable so system-generated events don't require a user.
  userId   String?

  type        QuoteActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("quote_activities")
}

// ---------------------------------------------------------------------------
// M4 Sprint 3 — Invoicing & Payments
//
// The post-sale half of the revenue funnel: a Booking generates an Invoice,
// and Payments are recorded against the invoice until its balance is settled.
// This sprint is a payment *ledger*, not a payment gateway — money is received
// out-of-band (cash, bank transfer, card terminal, cheque) and recorded here.
// PaymentTransaction is the append-only CHARGE/REFUND ledger a future gateway
// adapter would write into, so adding online payments later is additive.
//
// Money discipline is identical to Booking/Quote: stored Decimal columns
// derived via integer-cents arithmetic (shared/lib/money.ts), recomputed by
// the domain layer after every mutation. Balance columns (amountPaid /
// amountRefunded / amountCredited) are stored the same way and recomputed by
// features/invoices/lib/recompute-balance.ts after every payment, refund, or
// credit-note change. Lifecycle transitions are enforced in the domain layer
// (features/invoices/lib/invoice-status.ts), not by the database.
// ---------------------------------------------------------------------------

/// Lifecycle of an invoice. DRAFT is editable; ISSUED locks the lines and
/// starts collection; PARTIALLY_PAID/PAID are *system* states driven by
/// recorded payments (never set manually); VOID cancels an invoice that has
/// no net payments. Overdue is deliberately NOT a stored status — it is
/// derived from `dueDate` + balance at read time so it never goes stale.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// Timeline event types for an invoice, mirroring the booking/quote feeds.
enum InvoiceActivityType {
  CREATED
  UPDATED
  ISSUED
  STATUS_CHANGED
  PAYMENT_RECORDED
  PAYMENT_REFUNDED
  CREDIT_NOTE_ISSUED
  CREDIT_NOTE_VOIDED
  INSTALLMENT_PLAN_CREATED
  INSTALLMENT_PLAN_REMOVED
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_REMOVED
  VOIDED
  NOTE
}

/// How a payment was received. This is a recording taxonomy, not a gateway
/// integration — ONLINE covers any provider-processed payment recorded here.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  ONLINE
  OTHER
}

/// Lifecycle of a recorded payment. COMPLETED payments count toward the
/// invoice balance; PENDING (e.g. a bank transfer awaiting arrival) and
/// FAILED do not. REFUNDED/PARTIALLY_REFUNDED are set by the refund action
/// from the payment's refunded amount.
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// What the payment is for, within the invoice's collection plan. DEPOSIT is
/// the up-front portion; INSTALLMENT pays a scheduled installment; BALANCE is
/// any other payment toward the outstanding amount.
enum PaymentKind {
  DEPOSIT
  INSTALLMENT
  BALANCE
}

/// Append-only ledger entry types under a payment. Recording a payment writes
/// a CHARGE; each refund writes a REFUND. Rows are never updated or deleted.
enum PaymentTransactionType {
  CHARGE
  REFUND
}

/// Timeline event types for a payment.
enum PaymentActivityType {
  CREATED
  COMPLETED
  FAILED
  REFUNDED
  UPDATED
  NOTE
}

/// Lifecycle of a credit note. ISSUED reduces the invoice's amount owed;
/// VOID reverses that (the note is kept for the audit trail, never deleted).
enum CreditNoteStatus {
  ISSUED
  VOID
}

/// Scheduled-installment state. PAID is set when linked completed payments
/// cover the installment amount. Overdue is derived from `dueDate` at read
/// time, same as the invoice's overdue flag.
enum InstallmentStatus {
  PENDING
  PAID
}

/// A bill for a customer, usually generated from a Booking (bookingId), but a
/// manual invoice with no booking is allowed. Monetary columns follow the
/// Booking/Quote discipline (stored, recomputed from lines); the balance
/// columns are recomputed from payments/credit notes on every financial
/// mutation. Balance due = total − amountCredited − (amountPaid − amountRefunded),
/// clamped at zero, all derived in integer cents.
model Invoice {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "INV-2026-0001").
  reference String

  bookingId  String?
  customerId String

  status InvoiceStatus @default(DRAFT)

  issuedAt DateTime?
  /// Payment deadline. Past this date with a balance due, the invoice is
  /// overdue (derived at read time, not a stored status).
  dueDate  DateTime?
  paidAt   DateTime?

  currency String  @default("USD")
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  /// Sum of COMPLETED payment charges. Recomputed after every payment change.
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  /// Sum of refund transactions. Recomputed alongside amountPaid.
  amountRefunded Decimal @default(0) @db.Decimal(12, 2)
  /// Sum of ISSUED credit notes. Recomputed on credit-note changes.
  amountCredited Decimal @default(0) @db.Decimal(12, 2)

  notes         String? @db.Text
  terms         String? @db.Text
  internalNotes String? @db.Text

  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // SetNull: deleting a booking must not destroy its financial records.
  booking         Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           InvoiceItem[]
  activities      InvoiceActivity[]
  payments        Payment[]
  creditNotes     CreditNote[]
  installmentPlan InstallmentPlan?

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([bookingId])
  @@index([customerId])
  @@map("invoices")
}

/// A single priced line on an invoice. Same shape as BookingItem/QuoteItem
/// (reusing BookingItemType) so booking→invoice generation is a direct copy.
model InvoiceItem {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  type        BookingItemType
  description String
  referenceId String?

  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice, captured at write time.
  amount    Decimal @default(0) @db.Decimal(12, 2)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_items")
}

/// Append-only timeline entry for an invoice (who did what, when).
model InvoiceActivity {
  id        String  @id @default(cuid())
  tenantId  String
  invoiceId String
  /// Actor. Nullable so system-generated events don't require a user.
  userId    String?

  type        InvoiceActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_activities")
}

/// A payment received against an invoice. `amount` is the charge; refunds
/// accumulate in `refundedAmount` (never exceeding `amount`) via REFUND
/// transactions. Currency always equals the invoice currency (enforced in
/// the action layer — no cross-currency settlement in this sprint).
model Payment {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "PAY-2026-0001").
  reference String

  invoiceId     String
  /// The scheduled installment this payment settles, if any.
  installmentId String?

  method PaymentMethod
  kind   PaymentKind   @default(BALANCE)
  status PaymentStatus @default(COMPLETED)

  amount         Decimal @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  currency       String  @default("USD")

  receivedAt        DateTime @default(now())
  /// Free-form external reference (bank transfer ID, cheque number, terminal
  /// receipt, provider charge id …).
  externalReference String?
  notes             String?  @db.Text

  /// Who recorded the payment (userId). Plain string — mirrors ownerId fields.
  recordedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: an invoice with recorded payments must not be hard-deleted
  // (invoices are soft-deleted/voided anyway); financial records stay intact.
  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  installment  Installment?         @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  activities   PaymentActivity[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, receivedAt])
  @@index([invoiceId])
  @@index([installmentId])
  @@map("payments")
}

/// Append-only money-movement ledger under a payment. One CHARGE row is
/// written when the payment is recorded; each refund writes a REFUND row.
/// Rows are never updated or deleted — corrections are new entries. A future
/// payment-gateway adapter writes its captures/refunds here.
model PaymentTransaction {
  id        String @id @default(cuid())
  tenantId  String
  paymentId String

  type   PaymentTransactionType
  amount Decimal                @default(0) @db.Decimal(12, 2)

  /// Free-form external reference for this movement (provider txn id, etc.).
  reference String?
  notes     String?

  occurredAt DateTime @default(now())
  /// Who recorded the movement (userId). Nullable for system entries.
  createdBy  String?
  createdAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@map("payment_transactions")
}

/// Append-only timeline entry for a payment (who did what, when).
model PaymentActivity {
  id        String  @id @default(cuid())
  tenantId  String
  paymentId String
  userId    String?

  type        PaymentActivityType
  title       String
  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@map("payment_activities")
}

/// A reduction of an invoice's amount owed (goodwill, correction, partial
/// cancellation). ISSUED notes subtract from the balance due; voiding a note
/// restores it. Notes are never deleted — they are financial records.
model CreditNote {
  id        String @id @default(cuid())
  tenantId  String
  /// Human-readable, per-tenant unique reference (e.g. "CN-2026-0001").
  reference String

  invoiceId String

  status CreditNoteStatus @default(ISSUED)
  amount Decimal          @default(0) @db.Decimal(12, 2)
  reason String?          @db.Text

  issuedAt DateTime  @default(now())
  voidedAt DateTime?

  /// Who issued the note (userId).
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("credit_notes")
}

/// A payment schedule for an invoice: an optional up-front deposit plus N
/// installments. The schedule amounts are generated cents-exact (they sum to
/// the invoice total precisely — see features/invoices/lib/installment-schedule.ts)
/// and captured at creation; a later invoice-total change requires recreating
/// the plan (enforced in the action layer: plans exist only on ISSUED invoices
/// whose lines are locked).
model InstallmentPlan {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String @unique

  /// Up-front deposit amount (0 = no deposit installment).
  depositAmount    Decimal @default(0) @db.Decimal(12, 2)
  /// Number of scheduled installments after the deposit.
  installmentCount Int

  notes String?

  /// Who created the plan (userId).
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([tenantId])
  @@map("installment_plans")
}

/// One scheduled amount within an installment plan. `sequence` 0 is the
/// deposit (when the plan has one); payments link back via `installmentId`
/// and the recording action marks the installment PAID once linked completed
/// payments cover `amount`.
model Installment {
  id       String @id @default(cuid())
  tenantId String
  planId   String

  sequence Int
  /// Display label ("Deposit", "Installment 1 of 4", …), captured at creation.
  label    String

  dueDate DateTime
  amount  Decimal  @default(0) @db.Decimal(12, 2)

  status InstallmentStatus @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([planId, sequence])
  @@index([tenantId])
  @@index([planId])
  @@map("installments")
}
