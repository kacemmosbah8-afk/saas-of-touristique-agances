// ===========================================================================
// M3 — CRM, Leads, Documents, Providers, Settings
//
// Owner/author references (ownerId, authorId, userId, uploadedById) are stored
// as plain String user ids rather than Prisma relations: they are display
// attribution, not integrity-critical, and keeping them off the User model
// avoids a dozen back-relations on an identity table. Child rows carry a
// `tenantId` column for the tenant-scoped client + RLS but cascade-delete
// through their parent, so only top-level entities declare a `Tenant` relation.
// ===========================================================================

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  CORPORATE
  AGENCY
  VIP
}

enum LeadSource {
  WEBSITE
  PLAN_MY_TRIP
  REFERRAL
  SOCIAL_MEDIA
  ADVERTISING
  WALK_IN
  PHONE
  EMAIL
  PARTNER
  OTHER
}

enum CommunicationPreference {
  EMAIL
  PHONE
  SMS
  WHATSAPP
  NONE
}

enum CustomerActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  EMAIL
  CALL
  MEETING
  TAG_ADDED
  CONVERTED
  OTHER
}

model Customer {
  id       String @id @default(cuid())
  tenantId String

  firstName String
  lastName  String
  email     String?
  phone     String?

  type   CustomerType   @default(INDIVIDUAL)
  status ResourceStatus @default(ACTIVE)

  leadSource              LeadSource?
  communicationPreference CommunicationPreference @default(EMAIL)

  dateOfBirth    DateTime?
  nationality    String?
  passportNumber String?
  passportExpiry DateTime?

  notes String? @db.Text

  /// Assigned account manager (userId). Plain string — see header note.
  ownerId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  addresses       Address[]
  customerTags    CustomerTag[]
  customerNotes   CustomerNote[]
  activities      CustomerActivity[]
  leads           Lead[]
  bookings        Booking[]
  quotes          Quote[]
  bookingRequests BookingRequest[]

  // Customer Portal Capability
  portalMagicLinks PortalMagicLink[]
  portalSessions   PortalSession[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, email])
  @@map("customers")
}

model Contact {
  id       String @id @default(cuid())
  tenantId String

  customerId String?

  firstName String
  lastName  String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("contacts")
}

model Address {
  id       String @id @default(cuid())
  tenantId String

  customerId String?

  label      String?
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?
